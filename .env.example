# 瑞玛丽小助手 配置覆盖文件（可选）
# 用法：复制为 .env 后修改需要的项；未列出的项使用代码内默认值。
# 位置：开发环境放项目根目录；打包版放 exe 同目录。

# 游戏窗口标题关键词（默认：伊瑟；国际服可改为 Etheria）
GAME_WINDOW_TITLE=伊瑟

# 游戏进程名（默认：yise.exe）
GAME_PROCESS_NAME=yise.exe

# 模板匹配置信度阈值（默认：0.75）
TEMPLATE_THRESHOLD=0.75

# 战斗结束最长等待秒数（默认：1200）
BATTLE_END_TIMEOUT=1200

# 退出战斗后等待页面切换秒数（默认：3）
EXIT_BATTLE_WAIT=3

# OCR 引擎：paddle | easyocr（默认：paddle）
OCR_ENGINE=paddle
